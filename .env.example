# ============================================================================
# Shorts Autopilot — environment variables (set these in Vercel → Project → Settings → Environment Variables)
# Everything marked REQUIRED must be set before the first deploy works.
# ============================================================================

# ---------- Core (REQUIRED) ----------
APP_URL=https://your-project.vercel.app          # your production URL, no trailing slash
APP_SECRET=                                     # 32+ random chars: `openssl rand -hex 32` (signs logins + encrypts tokens)
CRON_SECRET=                                    # 32+ random chars; also add as GitHub secret + cron-job.org header
OWNER_EMAIL=you@example.com                     # owner login
OWNER_PASSWORD=                                 # owner password (12+ chars)
OWNER_NAME=Your Name

# ---------- Storage (REQUIRED — auto-filled when you connect them in Vercel → Storage) ----------
KV_REST_API_URL=                                # Upstash Redis (Vercel Marketplace)
KV_REST_API_TOKEN=
BLOB_READ_WRITE_TOKEN=                          # Vercel Blob store

# ---------- Script AI (at least ONE required; order is set in Settings) ----------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
GEMINI_API_KEY=                                 # aistudio.google.com — NOT included in Google AI Pro / Jio plan; separate API key
GEMINI_MODEL=gemini-3.6-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# ---------- Voice clone (ElevenLabs recommended; FAL_KEY gives a zero-shot fallback) ----------
ELEVENLABS_API_KEY=                             # needs a paid plan (Starter+) for Instant Voice Cloning
ELEVENLABS_VOICE_ID=                            # optional: reuse an existing cloned voice instead of creating one
ELEVENLABS_MODEL=eleven_multilingual_v2

# ---------- Talking avatar + outfit looks (fal.ai) ----------
FAL_KEY=
# Optional model overrides (defaults shown)
# FAL_OMNIHUMAN_MODEL=fal-ai/bytedance/omnihuman/v1.5
# FAL_FABRIC_MODEL=veed/fabric-1.0
# FAL_LIPSYNC_MODEL=fal-ai/sync-lipsync/v2
# FAL_IMAGE_EDIT_MODEL=fal-ai/nano-banana/edit
# FAL_TTS_MODEL=fal-ai/f5-tts

# ---------- Trend research ----------
TRENDS_GEO=IN                                   # Google News / Trends region

# ---------- Google: YouTube upload + Sheets log (one OAuth client) ----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_SHEET_ID=                                # or paste it in Settings
# GOOGLE_SERVICE_ACCOUNT_JSON=                  # optional: write the sheet with a service account instead
# GOOGLE_REFRESH_TOKEN=                         # optional: bootstrap without clicking Connect

# ---------- Instagram (Instagram API with Instagram Login) ----------
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# or skip OAuth and paste a token in Connections / set:
# INSTAGRAM_ACCESS_TOKEN=
# INSTAGRAM_USER_ID=

# ---------- Facebook Page ----------
META_APP_ID=
META_APP_SECRET=
# FACEBOOK_PAGE_ID=                             # pick a specific page if you manage several
# FACEBOOK_PAGE_TOKEN=
META_GRAPH_VERSION=v23.0

# ---------- Threads ----------
THREADS_APP_ID=
THREADS_APP_SECRET=
# THREADS_ACCESS_TOKEN=
# THREADS_USER_ID=

# ---------- X (OAuth 2.0 app, type "Web App", confidential client) ----------
X_CLIENT_ID=
X_CLIENT_SECRET=

# ---------- LinkedIn (products: "Sign In with LinkedIn using OpenID Connect" + "Share on LinkedIn") ----------
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# LINKEDIN_VERSION=202608                        # defaults to two months back automatically

# ---------- Tuning ----------
# MAX_ACTIVE_JOBS=3
# WORKER_BUDGET_SEC=270                          # Hobby max function time is 300s; Pro can raise to 780
